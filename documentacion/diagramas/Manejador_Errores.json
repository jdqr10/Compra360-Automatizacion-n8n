          "schema": []
        },
        "options": {}
      },
      "id": "gsheet-guardar",
      "name": "Guardar en Google Sheets (COMPLETAR)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        650,
        300
